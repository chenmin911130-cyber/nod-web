# Copy to .env locally. Set the same keys on Railway.

AUTH_SECRET=
# Local only. Never set this on Railway.
AUTH_DISABLED=
ADMIN_TOKEN=leonardo
PUBLIC_URL=https://nod-web-production.up.railway.app
DATA_DIR=./data

# Clerk Google sign-in (dashboard.clerk.com → API keys + enable Google SSO)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional mail (password reset links log to stdout if missing)
RESEND_API_KEY=
MAIL_FROM=Nod <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Optional error tracking
SENTRY_DSN=

# Cloudflare R2 — session audio (wav) and notes (txt)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Cost caps (test phase: quota is off by default)
GLOBAL_DAILY_BUDGET_USD=25
QUOTA_DISABLED=1
STT_USD_PER_MINUTE=0.01
LLM_USD_PER_1K_IN=0.00014
LLM_USD_PER_1K_OUT=0.00028
