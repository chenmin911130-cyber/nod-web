# Copy to .env locally. Set the same keys on Railway.

AUTH_SECRET=
# Local only. Never set this on Railway.
AUTH_DISABLED=
# Required to reach /admin. Leave empty and the admin API stays disabled.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
PUBLIC_URL=https://nodpilot.com
DATA_DIR=./data

# Host lock: rejects any request whose Host is not listed here or in
# PUBLIC_URL (e.g. direct hits on the *.up.railway.app domain, which would
# bypass Cloudflare). Comma-separated. Auto-enabled when PUBLIC_URL is a
# real domain — keep PUBLIC_URL pointing at the production domain.
ALLOWED_HOSTS=nodpilot.com,www.nodpilot.com

# Clerk Google sign-in (dashboard.clerk.com → API keys + enable Google SSO).
# Production FAPI is clerk.nodpilot.com (CNAME). Do not set a Dashboard
# Frontend API proxy to https://nodpilot.com/__clerk — that path 403s.
# Allowed redirects: https://nodpilot.com/login, /signup, /sso-callback
# and the www siblings. Account Portal (accounts.nodpilot.com) is unused.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional mail (password reset links log to stdout if missing)
RESEND_API_KEY=
# Official inbox. Feedback copies land here (Cloudflare Email Routing → Gmail).
CONTACT_EMAIL=hello@nodpilot.com
MAIL_FROM=Nod <noreply@nodpilot.com>
# Optional: send via Cloudflare Email Sending (needs Workers Paid + token).
CF_API_TOKEN=
CF_ACCOUNT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Optional error tracking
SENTRY_DSN=

# Cloudflare R2 — session audio (wav) and notes (txt)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Cost caps. QUOTA_DISABLED=1 removes every spend limit, including the global
# daily budget below — keep it 0 anywhere real money is at stake.
GLOBAL_DAILY_BUDGET_USD=25
QUOTA_DISABLED=0
STT_USD_PER_MINUTE=0.01
LLM_USD_PER_1K_IN=0.00014
LLM_USD_PER_1K_OUT=0.00028

# ElevenLabs — speak translations (tap a line, or headphones live read-aloud)
ELEVENLABS_API_KEY=
