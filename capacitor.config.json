{
  "appId": "com.nodpilot.app",
  "appName": "Nodpilot",
  "webDir": "web/dist",
  "backgroundColor": "#05070a",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#05070a",
    "scheme": "Nod",
    "preferredContentMode": "mobile",
    "limitsNavigationsToAppBoundDomains": false,
    "allowsLinkPreview": false,
    "scrollEnabled": false
  },
  "android": {
    "backgroundColor": "#05070a",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "backgroundColor": "#05070a",
      "launchAutoHide": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#05070a"
    },
    "Keyboard": {
      "resize": "native",
      "style": "DARK"
    }
  },
  "server": {
    "iosScheme": "capacitor",
    "allowNavigation": []
  }
}
